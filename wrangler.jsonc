// Cloudflare Worker that serves the generated dashboard as static assets.
// deploy_dashboard.sh uploads it from this machine; nothing is built from git.
// It uploads only the site/ folder, which the script refills with index.html
// and _headers on every run, so statements in this folder are never published.
{
  "name": "bankstatement",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "assets": {
    "directory": "./site"
  }
}
